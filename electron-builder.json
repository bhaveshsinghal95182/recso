{
  "appId": "com.recso.app",
  "files": [
    "dist-electron/**/*",
    "dist-react/**/*",
    "package.json",
    "!**/velocity/src/**",
    "!**/velocity/target/**",
    "!**/velocity/Cargo.*",
    "!**/velocity/.*"
  ],
  "asarUnpack": ["**/velocity/*.node"],
  "extraResources": ["dist-electron/preload.cjs", "public/**/*"],
  "icon": "./public/R.png",
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Utility"
  },
  "win": {
    "target": ["portable", "msi"]
  }
}
