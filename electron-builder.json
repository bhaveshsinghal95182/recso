{
  "appId": "com.recso.app",
  "files": ["dist-electron/**/*", "dist-react/**/*", "package.json"],
  "asarUnpack": [
    "node_modules/ffmpeg-static/**",
    "node_modules/ffprobe-static/**",
    "node_modules/@remotion/compositor-*/**"
  ],
  "extraResources": ["dist-electron/preload.cjs", "public/**/*", "dist-remotion/**/*"],
  "icon": "./public/R.png",
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Utility"
  },
  "win": {
    "target": ["nsis"],
    "icon": "public/R.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "license": "build/license.txt"
  }
}
