{
  "appId": "com.recso.app",
  "files": ["dist-electron/**/*", "dist-react/**/*", "package.json"],
  "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/ffprobe-static/**"],
  "extraResources": ["dist-electron/preload.cjs", "public/**/*"],
  "icon": "./public/R.png",
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Utility"
  },
  "win": {
    "target": ["portable", "msi"]
  }
}
