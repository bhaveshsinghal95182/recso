{
  "appId": "com.recso.app",
  "files": ["dist-electron/**/*", "dist-react/**/*", "package.json"],
  "extraResources": ["public/**/*", "velocity/index.js", "velocity/*.node"],
  "icon": "./public/R.png",
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Utility"
  },
  "deb": {
    "depends": [
      "libgtk-3-0",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0",
      "libuuid1",
      "libsecret-1-0",
      "libpipewire-0.3-0",
      "libopus0",
      "xdg-desktop-portal"
    ]
  },
  "win": {
    "target": ["nsis", "appx"],
    "icon": "public/R.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "license": "build/license.txt"
  },
  "appx": {
    "displayName": "Recso",
    "publisherDisplayName": "Descentkatil",
    "publisher": "CN=ADBBA92C-68FC-4614-8695-A08D2C192895",
    "identityName": "Descentkatil.Recso",
    "applicationId": "Recso"
  }
}
